# ─────────────────────────────────────────────────────────────
# Aegis — plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas el `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────

# --- API (apps/api) -----------------------------------------
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
# Origen del frontend permitido por CORS
WEB_ORIGIN=http://localhost:3000

# --- Base de datos ------------------------------------------
# Puerto del host para el Postgres de docker-compose.
# Cámbialo si ya tienes otro Postgres ocupando el 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis

# Conexión que usan los tests de integración para CREAR sus propias bases de
# datos efímeras. Normalmente es la misma de arriba. Si no se define, se usa
# DATABASE_URL.
TEST_DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis

# --- Auth (BE2-02) ------------------------------------------
# Secreto para firmar los JWT de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
# Validez del reto de login, en segundos
AUTH_CHALLENGE_TTL_SECONDS=300

# --- Stellar (BE1) ------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
# Cuenta única que el signer global puede firmar. La usan el runbook M1 y la
# API cuando USE_FAKE_STELLAR=false; el ejecutor rechaza cualquier otro origen.
# Obligatoria si USE_FAKE_STELLAR=false.
STELLAR_DEMO_ACCOUNT_ADDRESS=
# Clave secreta del signer delegado del agente.
# Solo backend. Nunca en el frontend, nunca en logs, nunca al LLM.
# Obligatoria si USE_FAKE_STELLAR=false.
STELLAR_AGENT_SIGNER_SECRET=
STELLAR_TRANSACTION_TIMEOUT_SECONDS=180
# Solo las usa `pnpm --filter @aegis/stellar demo:m1 pay`.
STELLAR_DEMO_DESTINATION=
STELLAR_DEMO_AMOUNT=0.1000000

# Solo para los comandos de `demo:usdc` y `demo:signer`. La API NO necesita
# estas variables: no emite activos ni rota claves, solo mueve lo ya emitido.
# Ver docs/runbooks/usdc-test.md y docs/runbooks/signer.md
USDC_TEST_ISSUER_SECRET=
USDC_TEST_TRUST_LIMIT=1000000
USDC_TEST_FUND_AMOUNT=1000
STELLAR_NEW_AGENT_SIGNER_SECRET=
# Emisor del activo de prueba (BE1-11). Sin él solo se pueden enviar XLM.
# Ojo: en la red el activo se llama USDCTEST, sin guion bajo, porque Stellar
# solo admite códigos alfanuméricos. Dentro de Aegis se sigue llamando USDC_TEST.
USDC_TEST_ISSUER=

# --- Precios (ADR 0011) -------------------------------------
# `market` consulta la API pública de CoinGecko con caché.
# `fixed` no sale a la red: determinista, para tests y demos.
PRICE_SOURCE=market
PRICE_CACHE_TTL_SECONDS=60
PRICE_TIMEOUT_MS=4000
# Tasa fija de XLM. Solo se usa si el mercado no responde.
PRICE_XLM_USD=
# USDC_TEST lo emitimos nosotros: su precio es una convención.
PRICE_USDC_TEST_USD=1
# Se puede apuntar a otro servidor (o a un mock) en desarrollo.
MARKET_PRICE_BASE_URL=

# --- Agente / LLM (AI) --------------------------------------
# Clave directa de Groq Cloud. Solo backend; nunca va al navegador, prompts ni logs.
GROQ_API_KEY=
# Modelos servidos por Groq Cloud: GPT-OSS 20B primario y 120B como fallback.
AGENT_MODEL=openai/gpt-oss-20b
AGENT_FALLBACK_MODEL=openai/gpt-oss-120b
AGENT_TIMEOUT_MS=15000
# La suite compara ambos modelos Groq con checks deterministas y genera un JSONL
# local para revisar manualmente las respuestas humanas.
AGENT_EVAL_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
AGENT_EVAL_REPORT_PATH=.ai-agent-eval-results.jsonl

# --- Modo de desarrollo -------------------------------------
# true  = cliente falso, sin red. Para desarrollar y para los tests.
# false = Horizon de verdad (M2). Exige STELLAR_AGENT_SIGNER_SECRET y
#         STELLAR_DEMO_ACCOUNT_ADDRESS, y la API no arranca sin ellas.
USE_FAKE_STELLAR=true
# true = permite /auth/dev-login sin firma real. Solo en desarrollo.
ALLOW_DEV_LOGIN=true
