# ─────────────────────────────────────────────────────────────
# Aegis — plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas el `.env` real al repositorio.
# ─────────────────────────────────────────────────────────────

# --- API (apps/api) -----------------------------------------
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
# Origen del frontend permitido por CORS
WEB_ORIGIN=http://localhost:3000

# --- Base de datos ------------------------------------------
# Puerto del host para el Postgres de docker-compose.
# Cámbialo si ya tienes otro Postgres ocupando el 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis

# --- Auth (BE2-02) ------------------------------------------
# Secreto para firmar los JWT de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=12h
# Validez del reto de login, en segundos
AUTH_CHALLENGE_TTL_SECONDS=300

# --- Stellar (BE1) ------------------------------------------
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
# Clave secreta del signer delegado del agente.
# Solo backend. Nunca en el frontend, nunca en logs, nunca al LLM.
STELLAR_AGENT_SIGNER_SECRET=
# Emisor del activo de prueba USDC_TEST (Q-06)
USDC_TEST_ISSUER=

# --- Agente / LLM (AI) --------------------------------------
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
AGENT_LANGUAGE=es

# --- Modo de desarrollo -------------------------------------
# true = usa FakeStellarReader en vez de la red real (útil para BE2)
USE_FAKE_STELLAR=true
# true = permite /auth/dev-login sin firma real. Solo en desarrollo.
ALLOW_DEV_LOGIN=true
