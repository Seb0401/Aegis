{
  "name": "aegis",
  "version": "0.1.0",
  "private": true,
  "description": "Aegis — Agente financiero personal sobre Stellar con Policy Engine y AI Guardian",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "dev:api": "pnpm --filter @aegis/api dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @aegis/api db:generate",
    "db:migrate": "pnpm --filter @aegis/api db:migrate",
    "db:seed": "pnpm --filter @aegis/api db:seed",
    "dev:mcp": "pnpm --filter @aegis/mcp dev",
    "build:mcp": "pnpm --filter @aegis/mcp build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
