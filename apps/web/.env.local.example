# Copia este archivo a `.env.local`. Solo variables NEXT_PUBLIC_*: todo lo que
# haya aquí acaba en el bundle del navegador. Nunca pongas secretos.

# API de Aegis (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Muestra el botón de "entrar sin wallet". Debe coincidir con ALLOW_DEV_LOGIN
# del `.env` de la API; si no, el botón aparece y la API responde 403.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=true

# Dirección que usa ese botón (la del seed de la API).
NEXT_PUBLIC_DEV_ADDRESS=GA4NUZKMEFCS7ZDVMAWSUXHK6NJTURAKV2RMA673ZTOOGIE2VTAGK3XP
