{
  "name": "@aegis/api",
  "version": "0.1.0",
  "private": true,
  "description": "Orquestador: propuestas, políticas, Guardian, auditoría y auth",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "openapi": "tsx src/openapi.ts"
  },
  "dependencies": {
    "@aegis/agent": "workspace:*",
    "@aegis/contracts": "workspace:*",
    "@aegis/guardian": "workspace:*",
    "@aegis/policy-engine": "workspace:*",
    "@aegis/prices": "workspace:*",
    "@aegis/stellar": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.2",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
