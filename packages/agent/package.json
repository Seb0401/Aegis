{
  "name": "@aegis/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agente LLM: intención → propuesta, y explicador (AI)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval": "tsx src/evals/run.ts"
  },
  "dependencies": {
    "@aegis/contracts": "workspace:*",
    "@aegis/guardian": "workspace:^",
    "@ai-sdk/groq": "^4.0.48",
    "ai": "^7.0.111",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dotenv": "^18.0.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
