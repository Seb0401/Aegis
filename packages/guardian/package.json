{
  "name": "@aegis/guardian",
  "version": "0.1.0",
  "private": true,
  "description": "Señales de riesgo deterministas y score, más la explicación de respaldo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
